# Personal WhatsApp — the main number.
# Read and list by default. Sending and deletion stay off until you opt in.
# Copy to .env.personal (gitignored) and replace the token:
#   openssl rand -hex 32

MCP_BEARER_TOKEN=change-me-to-a-long-random-secret
OAUTH_PUBLIC_URL=
OAUTH_EMAIL=
OAUTH_PASSWORD_HASH=

PORT=8787
HOST=127.0.0.1
AUTH_DIR=./auth_info_personal
# HISTORY_DB_PATH=./auth_info_personal/history.sqlite
SESSION_ROLE=personal
# Opt in only when this number should send. Leave false for a read-only connector.
ALLOW_SEND=false
# Opt in only when this account may delete its own sent messages for everyone.
ALLOW_DELETE=false
# MEDIA_MAX_BYTES=16M
# MEDIA_SEND_DIR=

# Optional read-only /admin UI for this personal service. Leave unset on the assistant and on David.
# openssl rand -hex 32
# ADMIN_SECRET=

# Same value as DAVID_READ_SECRET in .env.david. The personal dashboard uses it to
# read David and to save style, approved contacts, and the cold-send cap. David
# uses it on GET /internal/lid-pn. It is not the admin login and not the MCP token.
# Compose sets DAVID_ADMIN_URL=http://david:8788. For a local Node process use:
# DAVID_ADMIN_URL=http://127.0.0.1:8788
# DAVID_READ_SECRET=

# Optional push of new incoming messages. Leave unset to disable. Personal service only.
# WEBHOOK_URL=https://example.com/whatsapp
# WEBHOOK_KEY=
# WEBHOOK_KEY_HEADER=Authorization
# WEBHOOK_KEY_PREFIX=Bearer 
# WEBHOOK_GROUP_JIDS=
# WEBHOOK_BATCH_SECONDS=600
# WEBHOOK_MAX_PER_HOUR=6

# Public hostname if the process binds a non-loopback interface and sees that Host header.
# ALLOWED_HOSTS=wa-personal.example.com,localhost
# BAILEYS_LOG_LEVEL=warn
