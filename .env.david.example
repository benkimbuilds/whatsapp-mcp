# David — the optional in-bridge WhatsApp assistant on a second number.
# Copy to .env.david on the VM only. Never commit .env.david.
#   openssl rand -hex 32
# David does not call Cursor. Do not put a Cursor API credential in this file or on the host.
# SWE_CODE_AGENT_WEBHOOK_URL is deprecated and is not called.

MCP_BEARER_TOKEN=change-me-to-a-long-random-secret
OAUTH_PUBLIC_URL=
OAUTH_EMAIL=
OAUTH_PASSWORD_HASH=

PORT=8788
HOST=127.0.0.1
AUTH_DIR=./auth_info_david
# HISTORY_DB_PATH=./auth_info_david/history.sqlite
SESSION_ROLE=david
DAVID_MODE=true
# David does not send owner-command replies, callback notices, or MCP messages
# until this is true. Compose does not turn it on.
ALLOW_SEND=false
# Opt in only when this account may delete its own sent messages for everyone.
ALLOW_DELETE=false
# MEDIA_MAX_BYTES=16M
# MEDIA_SEND_DIR=

# Required for the david session. Digits only, country code included, no plus sign.
# This phone can run owner commands and is allowlisted for every repo. There is no default.
OWNER_PHONE=
# Owner's name in David's canned replies ("I'm Alex's assistant"). Default: the owner.
OWNER_NAME=

# Tolerated and ignored. Group events are DMs plus messages that address David,
# unless DAVID_GROUP_ALL is true. This JID is not a gate.
AIBM_GROUP_JID=

# Secretary receives every inbound event, in one batch per window.
# Authorization: Bearer <key> and X-Webhook-Signature: sha256=<hmac of the raw body>.
SECRETARY_ESCALATION_WEBHOOK_URL=
SECRETARY_ESCALATION_WEBHOOK_KEY=
# Fixed window in seconds. 60 is the default. 0 flushes immediately. Invalid values use 60.
# SECRETARY_ESCALATION_BATCH_SECONDS=60

# Deprecated. Delivery ignores this URL. The key is only a fallback for the callback bearer.
SWE_CODE_AGENT_WEBHOOK_URL=
SWE_CODE_AGENT_WEBHOOK_KEY=

# Tolerated and ignored. David does not DM the owner on a timer.
FALLBACK_AFTER_MINUTES=30

# Group messages that do not mention or reply to David are skipped unless this is true.
# DAVID_GROUP_ALL=false
# Prior messages attached to each event. Default 10.
# DAVID_EVENT_CONTEXT_MESSAGES=10
# Paced sender. Defaults: typing 2000–12000 ms, 40 ms per character, 15000 ms between
# sends in one chat, 5 messages per minute, 40 per hour, give up after 60000 ms.
# DAVID_TYPING_MIN_MS=2000
# DAVID_TYPING_MAX_MS=12000
# DAVID_TYPING_MS_PER_CHAR=40
# DAVID_CHAT_GAP_MS=15000
# DAVID_SEND_PER_MINUTE=5
# DAVID_SEND_PER_HOUR=40
# DAVID_SEND_MAX_WAIT_MS=60000

# Public origin for code-agent results, no path. Example: https://wa-david.example.com
# The callback path is /david/cursor-callback on this process.
# DAVID_CALLBACK_PUBLIC_BASE=
# If empty, the callback reuses SWE_CODE_AGENT_WEBHOOK_KEY.
# DAVID_CALLBACK_SECRET=

# Quiet hours and the cold-send day use this IANA zone. Default UTC.
# DAVID_TIMEZONE=UTC

# Leave ADMIN_SECRET unset. David must not serve the HTML admin and must not get a public hostname.
# Set the same DAVID_READ_SECRET as in .env.personal. That enables GET /internal/admin,
# the style write, and the approved-contact writes for the personal dashboard. Same secret
# for both. openssl rand -hex 32
# DAVID_READ_SECRET=

# Asked only when this session's Baileys lid-mapping has no phone for a @lid JID.
# http only, localhost or one Compose label. Compose sets http://personal:8787.
# For a local Node process next to personal:
# PERSONAL_LID_URL=http://127.0.0.1:8787

# Leave the personal incoming-message webhook unset on David.
# WEBHOOK_URL=

# Public hostname if the process sees that Host header.
# ALLOWED_HOSTS=wa-david.example.com,localhost
# BAILEYS_LOG_LEVEL=warn
