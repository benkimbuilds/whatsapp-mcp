# Assistant (PA) WhatsApp — optional second number, added to team group chats.
# Use a different token, port, and auth directory than personal.
# Sending and deletion stay off until you opt in.
# Copy to .env.assistant (gitignored) and replace the token:
#   openssl rand -hex 32

MCP_BEARER_TOKEN=change-me-to-a-long-random-secret

PORT=8788
HOST=127.0.0.1
AUTH_DIR=./auth_info_assistant
# HISTORY_DB_PATH=./auth_info_assistant/history.sqlite
SESSION_ROLE=assistant
# Opt in only when this number should send.
ALLOW_SEND=false
# Opt in only when this account may delete its own sent messages for everyone.
ALLOW_DELETE=false
# MEDIA_MAX_BYTES=16M
# MEDIA_SEND_DIR=

# Public hostname if the process binds a non-loopback interface and sees that Host header.
# ALLOWED_HOSTS=wa-assistant.example.com,localhost
# BAILEYS_LOG_LEVEL=warn
