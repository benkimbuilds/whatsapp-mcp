# whatsapp-bridge: every environment variable, with a placeholder and a one-line description.
#
# This file is the reference list. For a real deploy, copy the role file that matches
# each process instead (they carry the right defaults for that role):
#   cp .env.personal.example  .env.personal    # main number (+ optional /admin dashboard)
#   cp .env.assistant.example .env.assistant   # optional second number, plain MCP
#   cp .env.david.example     .env.david       # optional in-bridge assistant (see DAVID.md)
# A single standalone process can also use this file as .env.
# Never commit a filled-in env file. Generate secrets with: openssl rand -hex 32

# ---------------------------------------------------------------------------
# Core (every process)
# ---------------------------------------------------------------------------
# Required. Static bearer token for /mcp, at least 16 chars. The placeholder is rejected at startup.
MCP_BEARER_TOKEN=change-me-to-a-long-random-secret
# HTTP listen port (Compose uses 8787 personal, 8788 assistant/David).
PORT=8787
# Bind address. 127.0.0.1 on a host; Compose sets 0.0.0.0 inside the container.
HOST=127.0.0.1
# Baileys multi-file auth directory for THIS account only. Holds the linked-device session.
AUTH_DIR=./auth_info_baileys
# SQLite history file. Defaults to AUTH_DIR/history.sqlite.
# HISTORY_DB_PATH=./auth_info_baileys/history.sqlite
# Short label (personal | assistant | david). Shown in logs, /healthz, and the MCP server name.
SESSION_ROLE=default
# Allow this process to send WhatsApp messages (true/false). Default false.
# MCP send tools, reactions, and David's owner-command replies and callbacks
# all stay off until this is true. Compose does not override it.
ALLOW_SEND=false
# Allow MCP clients to delete this account's own sent messages for everyone
# (whatsapp_delete_message). Messages from anyone else are always refused, and the
# bridge history keeps the row. Default false. Compose does not override it.
ALLOW_DELETE=false
# Largest file whatsapp_download_media returns or whatsapp_send_media sends.
# Bytes, or a K/M suffix. Default 16M, maximum 100M. Base64 is about a third larger.
# MEDIA_MAX_BYTES=16M
# Folder whatsapp_send_media may read `path` from. Unset refuses local paths;
# base64 and https URLs still work. In Docker, mount it into the container.
# MEDIA_SEND_DIR=/data/outbox
# Comma-separated Host headers accepted when HOST is not loopback (DNS-rebinding guard).
# ALLOWED_HOSTS=wa-personal.example.com,localhost
# pino log level for Baileys. Default warn.
# BAILEYS_LOG_LEVEL=warn

# ---------------------------------------------------------------------------
# Optional OAuth login (for MCP clients that cannot hold a secret header)
# ---------------------------------------------------------------------------
# Public HTTPS URL of this process ending in /mcp. Enables OAuth with the two values below.
OAUTH_PUBLIC_URL=
# The single owner's login email.
OAUTH_EMAIL=
# scrypt hash from `bash scripts/enable-oauth-password.sh`. Never the plain password.
OAUTH_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Admin dashboard (personal process only)
# ---------------------------------------------------------------------------
# Enables the /admin UI. Random, at least 24 chars, must not contain "change-me".
# ADMIN_SECRET=
# Shared by personal and David: personal reads/writes David's /internal/admin with it. 24+ chars.
# DAVID_READ_SECRET=
# Where personal reaches David. Compose sets http://david:8788.
# DAVID_ADMIN_URL=http://127.0.0.1:8788

# ---------------------------------------------------------------------------
# Incoming-message webhook (personal process only)
# ---------------------------------------------------------------------------
# URL that receives batched new incoming messages. Unset disables the webhook.
# WEBHOOK_URL=https://example.com/whatsapp-incoming
# Secret sent with each batch. Never logged.
# WEBHOOK_KEY=
# Header that carries the key. Default Authorization.
# WEBHOOK_KEY_HEADER=Authorization
# Text before the key. Default "Bearer " (with the space). Empty sends the key alone.
# WEBHOOK_KEY_PREFIX=Bearer 
# Comma-separated @g.us group JIDs to forward. DMs are always included.
# WEBHOOK_GROUP_JIDS=
# Batch window in seconds. Default 600.
# WEBHOOK_BATCH_SECONDS=600
# Max batches per rolling hour. Default 6.
# WEBHOOK_MAX_PER_HOUR=6

# ---------------------------------------------------------------------------
# David assistant (only on the david process; see DAVID.md)
# ---------------------------------------------------------------------------
# Turns this process into David. Compose sets it on the david service.
# DAVID_MODE=true
# Required for David. Owner's phone, digits only with country code. Owner commands come from here.
# OWNER_PHONE=15555550123
# Owner's name in David's canned replies. Default "the owner".
# OWNER_NAME=Alex
# Receives every inbound David event, batched. Empty stores events locally and posts nothing.
# SECRETARY_ESCALATION_WEBHOOK_URL=https://example.com/assistant-events
# Bearer key and HMAC secret for that webhook.
# SECRETARY_ESCALATION_WEBHOOK_KEY=
# Batch window in seconds. Default 60. 0 flushes immediately.
# SECRETARY_ESCALATION_BATCH_SECONDS=60
# Deprecated and not called. Kept for compatibility.
# SWE_CODE_AGENT_WEBHOOK_URL=
# Deprecated; only used as a fallback for DAVID_CALLBACK_SECRET.
# SWE_CODE_AGENT_WEBHOOK_KEY=
# Public origin (no path) for code-agent callbacks to /david/cursor-callback.
# DAVID_CALLBACK_PUBLIC_BASE=https://wa-david.example.com
# Bearer secret for the callback route.
# DAVID_CALLBACK_SECRET=
# IANA zone for quiet hours and the daily cold-send cap. Default UTC.
# DAVID_TIMEZONE=UTC
# Forward every group message, not only ones that address David. Default false.
# DAVID_GROUP_ALL=false
# Prior messages attached to each event. Default 10 (1-50).
# DAVID_EVENT_CONTEXT_MESSAGES=10
# Paced sender: typing delay bounds, per-character delay, gap per chat, rate caps, max wait.
# DAVID_TYPING_MIN_MS=2000
# DAVID_TYPING_MAX_MS=12000
# DAVID_TYPING_MS_PER_CHAR=40
# DAVID_CHAT_GAP_MS=15000
# DAVID_SEND_PER_MINUTE=5
# DAVID_SEND_PER_HOUR=40
# DAVID_SEND_MAX_WAIT_MS=60000
# Personal process URL David asks to map a @lid to a phone. Compose sets http://personal:8787.
# PERSONAL_LID_URL=http://127.0.0.1:8787
# Parsed and ignored (legacy). Leave blank.
# AIBM_GROUP_JID=
# Parsed and ignored (legacy). David never DMs the owner on a timer.
# FALLBACK_AFTER_MINUTES=30
